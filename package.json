{
  "name": "tradingview-setup-alert-bot",
  "version": "1.0.0",
  "description": "SMCshark — TradingView to Telegram bot for HTF to LTF Smart Money Concepts setups",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/jefo/tradingview-setup-alert-bot.git"
  },
  "keywords": [
    "tradingview",
    "telegram-bot",
    "smart-money-concepts",
    "smc",
    "bun",
    "typescript"
  ],
  "main": "src/app.ts",
  "scripts": {
    "start": "bun run src/app.ts",
    "dev:api": "bun --watch src/api.ts",
    "dev:bot": "bun --watch src/app.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "replay": "bun run scripts/replay.ts",
    "generate:visuals": "bun run scripts/generate-visuals.ts",
    "typecheck": "tsc --noEmit",
    "build": "bun run build:api && bun run build:bot",
    "build:api": "bun build ./src/api.ts --outfile ./build/api --compile",
    "build:bot": "bun build ./src/app.ts --outfile ./build/bot --compile",
    "deploy": "./deploy/deploy.sh"
  },
  "dependencies": {
    "dotenv": "^16.0.3",
    "envalid": "^7.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.7.0",
    "grammy": "^1.15.3",
    "ioredis": "^5.3.2",
    "mongodb": "^5.0.0",
    "winston": "^3.8.2"
  },
  "devDependencies": {
    "@grammyjs/types": "^3.1.2",
    "@types/express": "^4.17.17",
    "@types/express-rate-limit": "^6.0.0",
    "@types/mongodb": "^4.0.7",
    "@types/node": "^18.15.11",
    "@types/supertest": "^2.0.12",
    "bun-types": "latest",
    "supertest": "^6.3.3",
    "typescript": "^5.2.2"
  }
}
