# Telegram
BOT_TOKEN=123456:replace-with-real-token
# Use a private test channel for demos. The bot must be an admin with pin rights.
TELEGRAM_CHANNEL=@your_test_channel

# Runtime
NODE_ENV=development
PORT=3000
# true = log signals instead of sending them to Telegram (useful before a demo)
DRY_RUN=false

# Redis (docker-compose maps 6390 -> 6379)
REDIS_URL=redis://127.0.0.1:6390

# Webhook protection: TradingView calls /alert?secret=<WEBHOOK_SECRET>
WEBHOOK_SECRET=replace-with-random-hex

# Setup engine windows (seconds)
SETUP_POI_TO_ENTRY_SECONDS=86400
SETUP_ENTRY_TO_CONFIRM_SECONDS=14400
SETUP_BOS_TO_CHOCH_SECONDS=900

# MongoDB (optional for the demo; alerts still flow if it is down)
MONGODB_URL=mongodb://admin:change-me@127.0.0.1:27017/smcshark
MONGODB_DB=smcshark

# docker-compose credentials
MONGO_USER=admin
MONGO_PASSWORD=change-me
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=change-me-too
